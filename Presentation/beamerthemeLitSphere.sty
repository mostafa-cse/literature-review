% ==============================================================================
% BEAMER THEME: LitSphere Classic Academic (Times New Roman White & Black Style)
% Jashore University of Science and Technology (JUST)
% Department of Computer Science and Engineering (CSE)
% ==============================================================================

\ProvidesPackage{beamerthemeLitSphere}[2026/09/05 LitSphere Classic Times New Roman Theme]

\RequirePackage{tikz}
\usetikzlibrary{calc,shapes,arrows,positioning,fit}
\RequirePackage{booktabs}
\RequirePackage{pifont}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage[T1]{fontenc}
\RequirePackage{times}         % Times New Roman
\RequirePackage{graphicx}

% --- Color Palette (Clean Academic White & Dark) ---
\definecolor{DarkText}{RGB}{20, 25, 33}       % #141921 Crisp dark primary text
\definecolor{SubText}{RGB}{85, 95, 110}       % #555F6E Neutral dark secondary text
\definecolor{DividerLine}{RGB}{218, 222, 229} % #DADEE5 Hairline divider
\definecolor{NavyBlue}{RGB}{20, 45, 85}       % #142D55 Classic Academic Navy
\definecolor{DarkNavy}{RGB}{15, 25, 45}       % #0F192D
\definecolor{GoldAccent}{RGB}{180, 130, 20}   % #B48214 Academic Ochre / Gold
\definecolor{LightGold}{RGB}{250, 246, 235}   % Muted off-white
\definecolor{CardBG}{RGB}{255, 255, 255}      % Pure white (no gray boxes)
\definecolor{CardBorder}{RGB}{255, 255, 255}  % Pure white (no borders)

% Semantic Accent Colors
\definecolor{AccentGreen}{RGB}{20, 110, 55}   % #146E37
\definecolor{AccentAmber}{RGB}{180, 85, 10}   % #B4550A
\definecolor{AccentBlue}{RGB}{25, 80, 185}    % #1950B9
\definecolor{AccentRed}{RGB}{185, 28, 28}     % #B91C1C
\definecolor{AccentTeal}{RGB}{15, 115, 110}   % #0F736E
\definecolor{AccentPurple}{RGB}{100, 40, 195} % #6428C3

% Title Slide Brand Colors matching Reference Design
\definecolor{TitleOrange}{RGB}{245, 150, 33}   % #F59621 Reference Orange Bar
\definecolor{TitleGreen}{RGB}{18, 118, 64}     % #127640 Reference Green Title
\definecolor{DividerPurple}{RGB}{94, 24, 235}  % #5E18EB Reference Purple Center Line

% --- Global Beamer Color Mappings ---
\setbeamercolor{normal text}{fg=DarkText,bg=white}
\setbeamercolor{structure}{fg=DarkText}
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{item}{fg=DarkText}
\setbeamercolor{subitem}{fg=SubText}
\setbeamercolor{frametitle}{fg=DarkText,bg=white}
\setbeamercolor{footline}{fg=SubText,bg=white}

% --- Disable Standard Elements ---
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}

% --- Typography: Times New Roman ---
\usefonttheme{professionalfonts}
\renewcommand{\familydefault}{\rmdefault}

% --- Frametitle Template (Large Caption + Upward Horizontal Line) ---
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vspace*{0.08cm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.8cm,rightskip=0.8cm]{frametitle}%
    {\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000\fontsize{18pt}{21pt}\selectfont\bfseries\color{DarkText}\insertframetitle}\par\vspace{1.5pt}%
    {\color{black!25}\rule{\dimexpr\paperwidth-1.6cm\relax}{0.75pt}}%
  \end{beamercolorbox}%
  \vspace{0.04cm}%
}

% --- Footline Template (Page Number Only, Clean Minimalist) ---
\setbeamertemplate{footline}{%
  \ifnum\insertframenumber>0%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.40cm,dp=0.20cm,rightskip=0.8cm]{footline}%
    \hfill{\fontsize{9pt}{11pt}\selectfont\color{DarkText}\insertframenumber/\inserttotalframenumber}%
  \end{beamercolorbox}%
  \fi%
}

% --- Helper Macros (Clean, Unboxed Academic Format) ---
% 1. Unboxed Content Block
\newcommand{\infoCard}[5]{%
  % #1=width, #2=accentColor, #3=badge/tag, #4=title, #5=body
  \parbox[t]{#1}{%
    \raggedright
    \ifx\relax#3\relax\else
      {\fontsize{8.5pt}{10.5pt}\selectfont\bfseries\color{#2}\MakeUppercase{#3}}\par\vspace{1.5pt}
    \fi
    {\fontsize{12pt}{14.5pt}\selectfont\bfseries\color{DarkText}#4}\par\vspace{2pt}
    {\fontsize{9pt}{11.5pt}\selectfont\color{DarkText}#5}
  }%
}

% 2. Clean KPI / Stat Block
\newcommand{\statCard}[4]{%
  % #1=width, #2=accentColor, #3=number/stat, #4=label
  \parbox[t]{#1}{%
    \centering
    {\fontsize{18pt}{20pt}\selectfont\bfseries\color{DarkText}#3}\par\vspace{2pt}
    {\fontsize{9pt}{11pt}\selectfont\bfseries\color{SubText}#4}
  }%
}

% 3. Agenda Item
\newcommand{\agendaItem}[3]{%
  % #1=number, #2=title, #3=width
  \parbox[t]{#3}{%
    \textbf{\fontsize{9.5pt}{11.5pt}\selectfont\color{DarkText}#1.\hspace{0.2cm}#2}%
  }%
}

% 4. Custom Minimalist Progress Bar
\newcommand{\customProgressBar}[4]{%
  % #1=label, #2=percent(number), #3=totalWidth, #4=color
  \begin{tikzpicture}
    \node[anchor=west, font=\fontsize{8.5pt}{10.5pt}\selectfont\bfseries, text=DarkText] at (0, 0.32) {#1};
    \node[anchor=east, font=\fontsize{8.5pt}{10.5pt}\selectfont\bfseries, text=DarkText] at (#3, 0.32) {#2\%};
    % Track
    \fill[black!10] (0, 0) rectangle (#3, 0.14);
    % Fill
    \fill[#4] (0, 0) rectangle ({(#2/100.0)*#3}, 0.14);
  \end{tikzpicture}%
}

% 5. Status Pill (Clean subtle outline)
\newcommand{\statusPill}[3]{%
  % #1=text, #2=bg, #3=fg
  \tikz[baseline=-0.6ex]\node[fill=#2!12, text=#2, draw=#2!35, line width=0.4pt, rounded corners=1.5pt, font=\fontsize{6.5pt}{7.5pt}\selectfont\bfseries, inner sep=2pt] {#1};%
}

% --- Bullet Point Formatting ---
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\tiny\color{DarkText}$\blacksquare$}}
\setbeamertemplate{itemize subitem}{\raisebox{0.15ex}{\tiny\color{SubText}$\triangleright$}}
\setlength{\leftmargini}{12pt}
\setlength{\leftmarginii}{10pt}

\endinput
