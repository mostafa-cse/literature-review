{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "Frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/overview", "destination": "/home.html" },
    { "source": "/workspace", "destination": "/workspace.html" },
    { "source": "/app", "destination": "/workspace.html" },
    { "source": "/matrix", "destination": "/workspace.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/surveys", "destination": "/dashboard.html" },
    { "source": "/projects", "destination": "/dashboard.html" },
    { "source": "/review", "destination": "/review.html" },
    { "source": "/reader", "destination": "/review.html" },
    { "source": "/paper-preview", "destination": "/review.html" },
    { "source": "/review-react", "destination": "/review_react.html" },
    { "source": "/react-review", "destination": "/review_react.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-dashboard", "destination": "/admin.html" },
    { "source": "/control-center", "destination": "/admin.html" },
    { "source": "/db", "destination": "/db.html" },
    { "source": "/database", "destination": "/db.html" },
    { "source": "/db-explorer", "destination": "/db.html" },
    { "source": "/schema", "destination": "/db.html" },
    { "source": "/login", "destination": "/auth.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/signin", "destination": "/auth.html" },
    { "source": "/register", "destination": "/auth.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/settings", "destination": "/profile.html" },
    { "source": "/account", "destination": "/profile.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/about-us", "destination": "/about.html" },
    { "source": "/features", "destination": "/about.html" },
    { "source": "/shared/:token", "destination": "/workspace.html" },
    { "source": "/api/:path*", "destination": "https://litsphere-backend.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://litsphere-backend.onrender.com/uploads/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
