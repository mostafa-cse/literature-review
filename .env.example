# ==============================================================================
# LITSPHERE ACADEMIC SYSTEM ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
SESSION_SECRET=litsphere-academic-secure-session-token-32bytes-key-2026

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE: POSTGRESQL
# ------------------------------------------------------------------------------
# Standard connection string format:
# postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litsphere

# ------------------------------------------------------------------------------
# 2. CACHE & BACKGROUND JOBS: REDIS
# ------------------------------------------------------------------------------
# Connection string format for Redis (local or managed e.g. Upstash/Redis Cloud):
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE: CLOUDFLARE R2 OR SUPABASE S3 STORAGE
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=litsphere-papers
# For Cloudflare R2:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_PUBLIC_DOMAIN=https://pub-your_subdomain.r2.dev
# For Supabase S3 Storage:
# R2_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# R2_REGION=ap-southeast-1
# R2_PUBLIC_DOMAIN=https://<project-ref>.supabase.co/storage/v1/object/public/litsphere-papers

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE: NODEMAILER (OPTIONAL)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="LitSphere Security <noreply@litsphere.org>"
