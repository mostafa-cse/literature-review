# LitSphere Backend Environment Configuration

# ---------------------------------------------------------
# EMAIL SERVICE (NODEMAILER)
# ---------------------------------------------------------
# To enable fully functional email delivery (e.g., for Forgot Password),
# provide your Gmail account details below.
#
# IMPORTANT: You MUST use an "App Password", NOT your regular Gmail password.
# To generate an App Password:
# 1. Go to your Google Account -> Security.
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App Passwords" in the Security tab.
# 4. Create a new App Password for "LitSphere Mail" and paste the 16-character code below.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="LitSphere Security <your_email@gmail.com>"
